# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Production Dockerfile for the NestJS API.
# Multi-stage: deps -> build -> runtime, so the final image ships only
# production node_modules + compiled dist/, not devDependencies or source.
# ---------------------------------------------------------------------------

FROM node:20-alpine AS deps
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json* ./
# `npm ci` requires package.json and package-lock.json to be byte-for-byte
# in sync (every dependency + version present in both). If someone edits
# package.json (adds/removes a dependency) without regenerating the lock,
# `npm ci` fails hard with an "in sync" error. Rather than hide that with
# `|| true`, fall back to `npm install --include=dev`, which resolves from
# package.json directly and rewrites the lock inside this layer — the build
# still succeeds and the failure is printed, not swallowed. The real fix is
# still to run `npm install` locally and commit the regenerated lock file;
# install.sh does this automatically before invoking `docker build` (see
# remediate_lockfile_sync in install.sh) so this fallback should rarely
# trigger in normal use.
RUN if [ -f package-lock.json ]; then \
      npm ci --include=dev || { \
        echo '[deps] npm ci failed (package.json / package-lock.json are out of sync) — falling back to npm install --include=dev'; \
        npm install --include=dev; \
      }; \
    else \
      npm install --include=dev; \
    fi

FROM node:20-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npx prisma generate
COPY . .
RUN npm run build
# prisma/seed.ts is excluded from the main `nest build` (tsconfig.json
# excludes "prisma"). Compile it separately here, while devDependencies
# (typescript) are still available, so `npm run seed:prod` in the runtime
# image can run it with plain `node` — the runtime image only installs
# production deps and does not have ts-node/typescript.
RUN npm run build:seed

FROM node:20-alpine AS prod-deps
RUN apk add --no-cache openssl
WORKDIR /app
COPY package.json package-lock.json* ./
# Same npm-ci-can-fail-on-drift reasoning as the deps stage above.
RUN ( \
      if [ -f package-lock.json ]; then \
        npm ci --omit=dev || { \
          echo '[prod-deps] npm ci failed (package.json / package-lock.json are out of sync) — falling back to npm install --omit=dev'; \
          npm install --omit=dev; \
        }; \
      else \
        npm install --omit=dev; \
      fi \
    ) && npm cache clean --force
COPY prisma ./prisma
RUN npx prisma generate

FROM node:20-alpine AS runner
# DOCKER_GID must match the GID of /var/run/docker.sock on the HOST
# (run `stat -c '%g' /var/run/docker.sock` on the host to find it; 999 is
# the common default on Debian/Ubuntu). This lets the non-root "app" user
# read/write the bind-mounted socket without running the container as root.
ARG DOCKER_GID=999
RUN apk add --no-cache openssl curl tini \
  && addgroup -S app \
  && adduser -S app -G app \
  && EXISTING_GRP="$(awk -F: -v gid="${DOCKER_GID}" '$3==gid {print $1}' /etc/group)" \
  && if [ -z "$EXISTING_GRP" ]; then \
       addgroup -g "${DOCKER_GID}" docker; \
       EXISTING_GRP=docker; \
     fi \
  && adduser app "${EXISTING_GRP}"

WORKDIR /app
ENV NODE_ENV=production

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/prisma ./prisma
COPY --from=build /app/dist ./dist
COPY package.json ./

# Branding uploads dir (logo/favicon) must be writable by the non-root
# "app" user below; created here so it exists with the right owner even
# before the branding_uploads volume is mounted over it.
RUN mkdir -p /app/uploads/branding && chown -R app:app /app/uploads

# Server-owned bind mounts (SERVERS_ROOT / BACKUPS_ROOT) are created and
# owned by whatever the host maps in; the app itself runs as non-root but
# in the "docker" group so it can use the bind-mounted docker.sock.
USER app

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fs http://localhost:4000/api/health || exit 1

# tini as PID 1 for correct signal handling (SIGTERM -> graceful shutdown)
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
